# Deployment inputs. Copy to .env, then fill the blank settings.
# Lowercase GitHub owner/org for GHCR images (e.g. zr0aces) and image tag (latest or CalVer e.g. 2026.11.5):
GHCR_OWNER=zr0aces
IMAGE_TAG=latest
WEB_PORT=8080
# Must be an https:// origin in production (no trailing slash, e.g. https://gallery.example.com):
# Passkeys use this hostname; keep it stable. Enroll passkeys and authenticator MFA in Profile.
APP_URL=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/google/callback

# Supply four independent 64-character hex strings (run: openssl rand -hex 32 for each).
# - POSTGRES_PASSWORD: URL-safe hex password (do not use @, :, /, or ? unencoded)
# - SESSION_SECRET: >= 32 characters; signs session cookies (changing it signs everyone out)
# - TOKEN_ENCRYPTION_KEY: MUST be exact 64 hex characters (/^[a-fA-F0-9]{64}$/)
#   Encrypts authenticator seeds and provider credentials. Preserve on upgrades and back up separately.
# - BOOTSTRAP_SECRET: >= 24 characters (first owner claim only; not a password reset or MFA recovery key)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gallery:${POSTGRES_PASSWORD}@postgres:5432/gallery
REDIS_URL=redis://redis:6379
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
BOOTSTRAP_SECRET=

# Required for Google Photos OAuth (configured via environment, not the web UI).
# Use single quotes around literal values containing $.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional at boot (can also be configured in the web UI under Settings).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional runtime overrides (compose.yml defaults shown):
# NODE_ENV=production
# MAX_IMAGE_SIZE_MB=50
# MAX_VIDEO_SIZE_MB=200
# MIN_FREE_MB=1024
# STAGING_RETENTION_HOURS=24
# FAILED_RETENTION_DAYS=7
# THUMBNAIL_RETENTION_DAYS=30
