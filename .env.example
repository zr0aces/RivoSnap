APP_NAME=RivoSnap
WEB_PORT=8080
NODE_ENV=production
# Replace with your public HTTPS origin (no path or trailing slash).
# Passkeys use this hostname; keep it stable. Enroll passkeys and authenticator MFA in Profile.
APP_URL=https://gallery.example.com
TZ=Asia/Bangkok
# URL-safe password (no unencoded @, :, /, or ?; openssl rand -hex 32 works well).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gallery:${POSTGRES_PASSWORD}@postgres:5432/gallery
REDIS_URL=redis://redis:6379
# Optional at boot (can also be configured in the web UI under Settings).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Required for Google Photos OAuth (configured via environment, not the web UI).
# Use single quotes around literal values containing $.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/google/callback
# First install: generate each secret below separately with openssl rand -hex 32.
# At least 32 characters. Signs session cookies; changing it signs everyone out.
SESSION_SECRET=
# Exactly 64 hex characters. Encrypts authenticator seeds and provider credentials.
# Preserve on upgrades and back up separately from the database.
TOKEN_ENCRYPTION_KEY=
# At least 24 characters. First owner claim only; not a password reset or MFA recovery key.
BOOTSTRAP_SECRET=
STAGING_PATH=/data/staging
THUMBNAIL_PATH=/data/thumbnails
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=200
MIN_FREE_MB=1024
STAGING_RETENTION_HOURS=24
FAILED_RETENTION_DAYS=7
THUMBNAIL_RETENTION_DAYS=30
